# Django Settings
DEBUG=True
SECRET_KEY=your-local-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Email Configuration (Optional, for local testing)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=AptCare <your_email@gmail.com>

# Database Configuration
# Railway will automatically provide DATABASE_URL in production.
# For local development with MySQL, you can provide it here or just let the app fall back to default settings.
# DATABASE_URL=mysql://root:password@localhost:3306/aptcare_db

# External APIs
GROQ_API_KEY=your_groq_api_key_here
